CONFIG_GOODIX_FINGERPRINT=m
CONFIG_QCOM_PRIME_CORE_ONLINE_HELPER=m
CONFIG_TOUCHSCREEN_GOODIX_BRL_SPI=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_AWINIC_HAPTIC_HV=m
CONFIG_LEDS_AW20036=m
CONFIG_NT2_HWID=m
CONFIG_USB_NET_CDC_MBIM=m
CONFIG_NOTHING_BOOTLOADER_LOG=m
# CONFIG_NOTHING_WRITRBACK_KMSG is not set
CONFIG_NOTHING_TASK_MEMINFO=m
CONFIG_NOTHING_SIMULATED_NTC=m
CONFIG_PINCTRL_MSM_S2IDLE_DUMP=y
CONFIG_NT_SECURE_STATE=m
CONFIG_NOTHING_RESTART_HANDLER=m
CONFIG_NT_SLOT_STATE=m
CONFIG_NOTHING_SECURE_ELEMENT=m
CONFIG_BUILD_ARM64_DT_OVERLAY=y
CONFIG_IP_NF_TARGET_TTL=y
CONFIG_LOG_BUF_SHIFT=21

# CONFIG_FTS_TRUSTED_TOUCH is not set
# CONFIG_I2C_RTC6226_QCA is not set
# CONFIG_INPUT_QCOM_HV_HAPTICS is not set
# CONFIG_MSM_SPCOM is not set
# CONFIG_MSM_SPSS_UTILS is not set
# CONFIG_QCOM_SPSS is not set
# CONFIG_QCOM_SPSS_AC_RESTRICTION is not set
# CONFIG_RPMSG_QCOM_GLINK_SPSS is not set

# Disable debugging
# CONFIG_ARM_QCOM_CPUFREQ_HW_DEBUG is not set
# CONFIG_SPMI_MSM_PMIC_ARB_DEBUG is not set
# CONFIG_QCOM_ESOC_DEBUG is not set
# CONFIG_QTI_BATTERY_GLINK_DEBUG is not set
# CONFIG_INTERCONNECT_QCOM_DEBUG is not set
# CONFIG_RCU_TRACE is not set
# CONFIG_PID_IN_CONTEXTIDR is not set
# CONFIG_CORESIGHT is not set
# CONFIG_KUNIT is not set

# Disable diwali chipset related configs
# CONFIG_ARCH_DIWALI is not set
# CONFIG_INTERCONNECT_QCOM_DIWALI is not set
# CONFIG_PINCTRL_DIWALI is not set
# CONFIG_SM_CAMCC_DIWALI is not set
# CONFIG_SM_DEBUGCC_DIWALI is not set
# CONFIG_SM_DISPCC_DIWALI is not set
# CONFIG_SM_GCC_DIWALI is not set
# CONFIG_SM_GPUCC_DIWALI is not set
# CONFIG_SM_VIDEOCC_DIWALI is not set

# Disable parrot chipset related configs
# CONFIG_INTERCONNECT_QCOM_PARROT is not set

# --- KernelSU (Manual Hooks Mode) ---
CONFIG_KSU=y
CONFIG_KSU_KPROBES_HOOK=n
CONFIG_KSU_DEBUG=n

# --- SUSFS 2.0 Configuration ---
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_TRY_UMOUNT=y
CONFIG_KSU_SUSFS_AUTO_ADD_SUS_KSU_DEFAULT_MOUNT=y
CONFIG_KSU_SUSFS_AUTO_ADD_SUS_BIND_MOUNT=y
CONFIG_KSU_SUSFS_AUTO_ADD_TRY_UMOUNT_FOR_BIND_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SUS_OVERLAYFS=n
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SUS_MAP=y
CONFIG_KSU_SUSFS_SUS_SU=n
